OCTOTEACHER_ENV=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/octoteacher
SUPABASE_URL=https://your-project.supabase.co
GUESTBOOK_CHALLENGE_SECRET=replace-with-at-least-32-random-characters

# Keep runtime writes and dangerous routes disabled unless you are operating
# an isolated environment and understand the affected workflows.
OCTOTEACHER_ENABLE_RUNTIME_WRITES=false
OCTOTEACHER_ENABLE_DANGEROUS_ROUTES=false
